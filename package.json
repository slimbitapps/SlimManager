{
  "name": "slimmanager",
  "version": "1.0.0",
  "description": "Moderner Task-Manager für Gamer – anpassbares Dashboard, Game Boost, Live-Werte aufs Handy (Tauri)",
  "scripts": {
    "start": "vite build && tauri dev",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.cjs && node --experimental-strip-types --no-warnings --test test/*.test.mjs",
    "test:e2e": "vite build && node test/e2e/run.cjs",
    "icons": "electron scripts/make-icons.cjs && tauri icon brand/icon-1024.png -o src-tauri/icons && rm -rf src-tauri/icons/android src-tauri/icons/ios",
    "core": "bash scripts/build-core.sh",
    "dist": "bash scripts/build-core.sh && tauri build"
  },
  "author": "SlimBit Apps",
  "license": "UNLICENSED",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "esbuild": "^0.28.2",
    "nosleep.js": "^0.12.0",
    "playwright-core": "^1.56.0",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "qrcode": "^1.5.4",
    "systeminformation": "^5.33.16",
    "ws": "^8.18.3"
  },
  "productName": "SlimManager",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/slimbitapps/SlimManager.git"
  }
}
